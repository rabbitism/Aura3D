<ex:Demo x:Class="Aura3D.Gallery.Demos.ParticlesDemo"
         xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ex="clr-namespace:Aura3D.Gallery"
         xmlns:demos="clr-namespace:Aura3D.Gallery.Demos"
         xmlns:kit="clr-namespace:Aura3D.Gallery.Kit"
         x:DataType="demos:ParticlesViewModel">

  <!--
    粒子页：MVVM 试点。文案与参数全部绑定 ParticlesViewModel——标签是 Lingua observable
    （^ 绑定，换语言自动生效），行控件值走双向绑定写穿到发射器对象。
    视图 code-behind 只剩生命周期：取资产、装场景、逐帧 Tick。
  -->
  <Panel>

    <kit:DemoView x:Name="View" Pipeline="BlinnPhong" />

    <kit:InspectorPanel>
      <StackPanel Spacing="6">

        <kit:Hint Text="{Binding IntroLabel^}" />

        <kit:Section Title="{Binding FountainSectionLabel^}" />

        <kit:SliderRow Label="{Binding FountainRateLabel^}" Minimum="0" Maximum="6000" Format="0"
                       Value="{Binding FountainRate}" />
        <kit:SliderRow Label="{Binding FountainConeAngleLabel^}" Minimum="0" Maximum="80" Format="0"
                       Value="{Binding FountainConeAngle}" />
        <kit:SliderRow Label="{Binding FountainGravityLabel^}" Minimum="-30" Maximum="5" Format="0.0"
                       Value="{Binding FountainGravityY}" />
        <kit:SliderRow Label="{Binding FountainDampingLabel^}" Minimum="0" Maximum="6"
                       Value="{Binding FountainDamping}" />
        <kit:SliderRow Label="{Binding FountainStartSizeLabel^}" Minimum="0.05" Maximum="3"
                       Value="{Binding FountainStartSize}" />

        <kit:ComboRow Label="{Binding TextureLabel^}" Options="{Binding TextureOptions}"
                      SelectedItem="{Binding SelectedTexture}" />

        <kit:SliderRow Label="{Binding FlipbookTilesLabel^}" Minimum="1" Maximum="8" Format="0"
                       Value="{Binding FlipbookTiles}" />

        <kit:Hint Text="{Binding FlipbookNoteLabel^}" />

        <kit:Section Title="{Binding BurstSectionLabel^}" />

        <kit:SliderRow Label="{Binding BurstRateLabel^}" Minimum="0" Maximum="60000" Format="0"
                       Value="{Binding BurstRate}" />
        <kit:SliderRow Label="{Binding BurstDurationLabel^}" Minimum="0" Maximum="4"
                       Value="{Binding BurstDuration}" />
        <kit:SliderRow Label="{Binding BurstLifetimeLabel^}" Minimum="0.2" Maximum="8"
                       Value="{Binding BurstLifetime}" />
        <kit:SliderRow Label="{Binding BurstVelocityLabel^}" Minimum="0" Maximum="20" Format="0.0"
                       Value="{Binding BurstVelocity}" />

        <Button Content="{Binding ReplayBurstLabel^}" Command="{Binding ReplayBurstCommand}" HorizontalAlignment="Stretch" />

        <kit:Section Title="{Binding DebrisSectionLabel^}" />

        <kit:SliderRow Label="{Binding DebrisRateLabel^}" Minimum="0" Maximum="400" Format="0"
                       Value="{Binding DebrisRate}" />
        <kit:SliderRow Label="{Binding DebrisSpinLabel^}" Minimum="0" Maximum="12" Format="0.0"
                       Value="{Binding DebrisSpin}" />
        <kit:SliderRow Label="{Binding DebrisMeshScaleLabel^}" Minimum="0.1" Maximum="4"
                       Value="{Binding DebrisMeshScale}" />
        <kit:SliderRow Label="{Binding DebrisMaxParticlesLabel^}" Minimum="50" Maximum="20000" Format="0"
                       Value="{Binding DebrisMaxParticles}" />

        <Button Content="{Binding ApplyDebrisLabel^}" Command="{Binding ApplyDebrisCommand}" HorizontalAlignment="Stretch" />

        <kit:Section Title="{Binding SharedSectionLabel^}" />

        <kit:ComboRow Label="{Binding BlendModeLabel^}" Options="{Binding BlendModeOptions}"
                      SelectedItem="{Binding SelectedBlendMode}" />

        <Button Content="{Binding RestartAllLabel^}" Command="{Binding RestartAllCommand}" HorizontalAlignment="Stretch" />

        <kit:ToggleRow Label="{Binding PauseAllLabel^}" IsChecked="{Binding PauseAll}" />
        <kit:ToggleRow Label="{Binding CullingLabel^}" IsChecked="{Binding Culling}" />
        <kit:ToggleRow Label="{Binding ShowBoundsLabel^}" IsChecked="{Binding ShowBounds}" />

        <kit:ReadoutRow Label="{Binding StateLabel^}" Text="{Binding ReadoutText^}" />

      </StackPanel>
    </kit:InspectorPanel>

  </Panel>
</ex:Demo>
