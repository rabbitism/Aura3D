<ex:Demo x:Class="Aura3D.Gallery.Demos.ParticlesDemo"
         xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:loc="clr-namespace:Aura3D.Gallery.Localization"
         xmlns:ex="clr-namespace:Aura3D.Gallery"
         xmlns:demos="clr-namespace:Aura3D.Gallery.Demos"
         xmlns:kit="clr-namespace:Aura3D.Gallery.Kit"
         x:DataType="demos:ParticlesViewModel">

  <!--
    粒子页：MVVM 试点。文案与参数全部绑定 ParticlesViewModel——标签是 Lingua observable
    （^ 绑定，换语言自动生效），行控件值走双向绑定写穿到发射器对象。
    视图 code-behind 只剩生命周期：取资产、装场景、逐帧 Tick。
  -->
  <Panel>

    <kit:DemoView x:Name="View" Pipeline="BlinnPhong" />

    <kit:InspectorPanel>
      <StackPanel Spacing="6">

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.Particles_Intro}}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.Particles_Fountain}}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Particles_FountainRate}}" Minimum="0" Maximum="6000" Format="0"
                       Value="{Binding FountainRate}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Particles_ConeAngle}}" Minimum="0" Maximum="80" Format="0"
                       Value="{Binding FountainConeAngle}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Particles_GravityY}}" Minimum="-30" Maximum="5" Format="0.0"
                       Value="{Binding FountainGravityY}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Particles_Damping}}" Minimum="0" Maximum="6"
                       Value="{Binding FountainDamping}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Particles_StartSize}}" Minimum="0.05" Maximum="3"
                       Value="{Binding FountainStartSize}" />

        <kit:ComboRow Label="{Translate {x:Static loc:Strings+Keys.Particles_Map}}" Options="{Binding TextureOptions}"
                      SelectedItem="{Binding SelectedTexture}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Particles_FlipbookTiles}}" Minimum="1" Maximum="8" Format="0"
                       Value="{Binding FlipbookTiles}" />

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.Particles_FlipbookNote}}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.Particles_Burst}}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Particles_BurstRate}}" Minimum="0" Maximum="60000" Format="0"
                       Value="{Binding BurstRate}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Particles_Duration}}" Minimum="0" Maximum="4"
                       Value="{Binding BurstDuration}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Particles_MaxLife}}" Minimum="0.2" Maximum="8"
                       Value="{Binding BurstLifetime}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Particles_MaxSpeed}}" Minimum="0" Maximum="20" Format="0.0"
                       Value="{Binding BurstVelocity}" />

        <Button Content="{Translate {x:Static loc:Strings+Keys.Particles_Replay}}" Command="{Binding ReplayBurstCommand}" HorizontalAlignment="Stretch" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.Particles_Debris}}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Particles_DebrisRate}}" Minimum="0" Maximum="400" Format="0"
                       Value="{Binding DebrisRate}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Particles_SpinSpeed}}" Minimum="0" Maximum="12" Format="0.0"
                       Value="{Binding DebrisSpin}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Particles_MeshScale}}" Minimum="0.1" Maximum="4"
                       Value="{Binding DebrisMeshScale}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Particles_MaxParticles}}" Minimum="50" Maximum="20000" Format="0"
                       Value="{Binding DebrisMaxParticles}" />

        <Button Content="{Translate {x:Static loc:Strings+Keys.Particles_ApplyMaxParticles}}" Command="{Binding ApplyDebrisCommand}" HorizontalAlignment="Stretch" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.Particles_Shared}}" />

        <kit:ComboRow Label="{Translate {x:Static loc:Strings+Keys.Particles_BlendMode}}" Options="{Binding BlendModeOptions}"
                      SelectedItem="{Binding SelectedBlendMode}" />

        <Button Content="{Translate {x:Static loc:Strings+Keys.Particles_RestartAll}}" Command="{Binding RestartAllCommand}" HorizontalAlignment="Stretch" />

        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.Particles_PauseAll}}" IsChecked="{Binding PauseAll}" />
        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.Particles_VisibilityCulling}}" IsChecked="{Binding Culling}" />
        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.Particles_ShowBounds}}" IsChecked="{Binding ShowBounds}" />

        <kit:ReadoutRow Label="{Translate {x:Static loc:Strings+Keys.Particles_State}}" Text="{Binding ReadoutText^}" />

      </StackPanel>
    </kit:InspectorPanel>

  </Panel>
</ex:Demo>
