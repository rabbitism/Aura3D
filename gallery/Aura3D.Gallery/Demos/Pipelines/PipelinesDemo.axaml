<ex:Demo x:Class="Aura3D.Gallery.Demos.PipelinesDemo"
         xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ex="clr-namespace:Aura3D.Gallery"
         xmlns:demos="clr-namespace:Aura3D.Gallery.Demos"
         xmlns:kit="clr-namespace:Aura3D.Gallery.Kit"
         x:DataType="demos:PipelinesViewModel">

  <!--
    五条管线对照页。文案与灯光参数全部绑定 PipelinesViewModel——标签是 Lingua observable
    （^ 绑定，换语言自动生效），行控件值走双向绑定写穿到 VM 里的两个灯；
    两条读数也由 VM 持有，视图逐帧把管线事实喂进去。
    这里声明的只是注册表里的默认管线；换管线用宿主状态栏的管线框（全示例统一走那一个入口）。
  -->
  <Panel>

    <kit:DemoView x:Name="View" Pipeline="BlinnPhong" />

    <kit:InspectorPanel>
      <StackPanel Spacing="6">

        <kit:Hint Text="{Binding IntroLabel^}" />

        <kit:Section Title="{Binding LightsSectionLabel^}" />

        <kit:SliderRow Label="{Binding LightPitchLabel^}" Minimum="-89" Maximum="0" Format="0"
                       Value="{Binding SunPitch}" />

        <kit:ToggleRow Label="{Binding LightShadowLabel^}" IsChecked="{Binding SunCastShadow}" />
        <kit:ToggleRow Label="{Binding PointLightVisibleLabel^}" IsChecked="{Binding PointVisible}" />

        <kit:Section Title="{Binding ReadoutSectionLabel^}" />

        <kit:ReadoutRow Label="{Binding ChannelsLabel^}" Text="{Binding ChannelsText^}" />
        <kit:ReadoutRow Label="{Binding PassesLabel^}" Text="{Binding PassesText}" />

      </StackPanel>
    </kit:InspectorPanel>

  </Panel>
</ex:Demo>
