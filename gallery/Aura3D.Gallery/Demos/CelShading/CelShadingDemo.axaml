<ex:Demo x:Class="Aura3D.Gallery.Demos.CelShadingDemo"
         xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ex="clr-namespace:Aura3D.Gallery"
         xmlns:demos="clr-namespace:Aura3D.Gallery.Demos"
         xmlns:kit="clr-namespace:Aura3D.Gallery.Kit"
         x:DataType="demos:CelShadingViewModel">

  <!--
    卡通着色页。文案与参数全部绑定 CelShadingViewModel——标签是 Lingua observable
    （^ 绑定，换语言自动生效），通道开关与滑杆值走双向绑定写穿到身体/脸两个卡通材质。
    视图 code-behind 只剩生命周期：取角色资产、装场景、逐帧 Tick。
  -->
  <Panel>

    <kit:DemoView x:Name="View" Pipeline="CelShading" />

    <kit:InspectorPanel>
      <StackPanel Spacing="6">

        <kit:Hint Text="{Binding IntroLabel^}" />

        <kit:Section Title="{Binding ChannelsSectionLabel^}" />

        <kit:ToggleRow Label="{Binding BaseColorLabel^}" IsChecked="{Binding BaseColorPlugged}" />
        <kit:ToggleRow Label="{Binding NormalLabel^}" IsChecked="{Binding NormalPlugged}" />
        <kit:ToggleRow Label="{Binding IlmLabel^}" IsChecked="{Binding IlmPlugged}" />
        <kit:ToggleRow Label="{Binding ShadowRampLabel^}" IsChecked="{Binding ShadowRampPlugged}" />
        <kit:ToggleRow Label="{Binding SdfLabel^}" IsChecked="{Binding SdfPlugged}" />
        <kit:ToggleRow Label="{Binding SpecularRampLabel^}" IsChecked="{Binding SpecularRampPlugged}" />

        <kit:Section Title="{Binding HalfLambertSectionLabel^}" />

        <kit:SliderRow Label="{Binding GreyFacLabel^}" Minimum="0.05" Maximum="2"
                       Value="{Binding GreyFac}" />
        <kit:SliderRow Label="{Binding DarkFacLabel^}" Minimum="-1" Maximum="1"
                       Value="{Binding DarkFac}" />
        <kit:SliderRow Label="{Binding BrightFacLabel^}" Minimum="0" Maximum="1"
                       Value="{Binding BrightFac}" />
        <kit:SliderRow Label="{Binding BrightAreaShadowFacLabel^}" Minimum="0" Maximum="1"
                       Value="{Binding BrightAreaShadowFac}" />

        <kit:Section Title="{Binding RampRowsSectionLabel^}" />

        <kit:SliderRow Label="{Binding RampIndex0Label^}" Minimum="0" Maximum="5"
                       Value="{Binding RampIndex0}" />
        <kit:SliderRow Label="{Binding RampIndex1Label^}" Minimum="0" Maximum="5"
                       Value="{Binding RampIndex1}" />
        <kit:SliderRow Label="{Binding RampIndex2Label^}" Minimum="0" Maximum="5"
                       Value="{Binding RampIndex2}" />
        <kit:SliderRow Label="{Binding RampIndex3Label^}" Minimum="0" Maximum="5"
                       Value="{Binding RampIndex3}" />
        <kit:SliderRow Label="{Binding RampIndex4Label^}" Minimum="0" Maximum="5"
                       Value="{Binding RampIndex4}" />

        <kit:Hint Text="{Binding RampRowsNoteLabel^}" />

        <kit:Section Title="{Binding TintSlotsSectionLabel^}" />

        <kit:SliderRow Label="{Binding LightAreaTintLabel^}" Minimum="0" Maximum="2"
                       Value="{Binding LightAreaTint}" />
        <kit:SliderRow Label="{Binding DarkShadowLabel^}" Minimum="0" Maximum="2"
                       Value="{Binding DarkShadowTint}" />
        <kit:SliderRow Label="{Binding CoolShadowLabel^}" Minimum="0" Maximum="2"
                       Value="{Binding CoolShadowTint}" />

        <kit:Hint Text="{Binding CoolShadowNoteLabel^}" />

        <kit:Section Title="{Binding FaceOnlySectionLabel^}" />

        <kit:SliderRow Label="{Binding FaceShadowOffsetLabel^}" Minimum="-1" Maximum="1"
                       Value="{Binding FaceShadowOffset}" />
        <kit:SliderRow Label="{Binding FaceShadowSoftnessLabel^}" Minimum="0.01" Maximum="1"
                       Value="{Binding FaceShadowSoftness}" />

        <kit:ToggleRow Label="{Binding FaceRenderTypeLabel^}" IsChecked="{Binding FaceRender}" />

        <kit:Section Title="{Binding DirectionalLightSectionLabel^}" />

        <kit:SliderRow Label="{Binding YawSpeedLabel^}" Minimum="0" Maximum="90"
                       Value="{Binding SunYawSpeed}" />

        <kit:Section Title="{Binding OutlinePassSectionLabel^}" />

        <kit:SliderRow Label="{Binding OutlineAmbientLabel^}" Minimum="0" Maximum="1"
                       Value="{Binding OutlineAmbient}" />

        <kit:Hint Text="{Binding OutlineNoteLabel^}" />

        <kit:SliderRow Label="{Binding SettingsAmbientLabel^}" Minimum="0" Maximum="2"
                       Value="{Binding SettingsAmbient}" />

        <kit:ReadoutRow Label="{Binding BindingsLabel^}" Text="{Binding ReadoutText^}" />

      </StackPanel>
    </kit:InspectorPanel>

  </Panel>
</ex:Demo>
