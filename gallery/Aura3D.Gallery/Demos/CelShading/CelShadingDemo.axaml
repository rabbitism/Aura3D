<ex:Demo x:Class="Aura3D.Gallery.Demos.CelShadingDemo"
         xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:loc="clr-namespace:Aura3D.Gallery.Localization"
         xmlns:ex="clr-namespace:Aura3D.Gallery"
         xmlns:demos="clr-namespace:Aura3D.Gallery.Demos"
         xmlns:kit="clr-namespace:Aura3D.Gallery.Kit"
         x:DataType="demos:CelShadingViewModel">

  <!--
    卡通着色页。文案与参数全部绑定 CelShadingViewModel——标签是 Lingua observable
    （^ 绑定，换语言自动生效），通道开关与滑杆值走双向绑定写穿到身体/脸两个卡通材质。
    视图 code-behind 只剩生命周期：取角色资产、装场景、逐帧 Tick。
  -->
  <Panel>

    <kit:DemoView x:Name="View" Pipeline="CelShading" />

    <kit:InspectorPanel>
      <StackPanel Spacing="6">

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.CelShading_Intro}}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.CelShading_Channels}}" />

        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.CelShading_BaseColor}}" IsChecked="{Binding BaseColorPlugged}" />
        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.CelShading_Normal}}" IsChecked="{Binding NormalPlugged}" />
        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.CelShading_Ilm}}" IsChecked="{Binding IlmPlugged}" />
        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.CelShading_ShadowRamp}}" IsChecked="{Binding ShadowRampPlugged}" />
        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.CelShading_Sdf}}" IsChecked="{Binding SdfPlugged}" />
        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.CelShading_SpecularRamp}}" IsChecked="{Binding SpecularRampPlugged}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.CelShading_HalfLambert}}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.CelShading_GreyFac}}" Minimum="0.05" Maximum="2"
                       Value="{Binding GreyFac}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.CelShading_DarkFac}}" Minimum="-1" Maximum="1"
                       Value="{Binding DarkFac}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.CelShading_BrightFac}}" Minimum="0" Maximum="1"
                       Value="{Binding BrightFac}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.CelShading_BrightAreaShadowFac}}" Minimum="0" Maximum="1"
                       Value="{Binding BrightAreaShadowFac}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.CelShading_RampRows}}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.CelShading_RampIndex0}}" Minimum="0" Maximum="5"
                       Value="{Binding RampIndex0}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.CelShading_RampIndex1}}" Minimum="0" Maximum="5"
                       Value="{Binding RampIndex1}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.CelShading_RampIndex2}}" Minimum="0" Maximum="5"
                       Value="{Binding RampIndex2}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.CelShading_RampIndex3}}" Minimum="0" Maximum="5"
                       Value="{Binding RampIndex3}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.CelShading_RampIndex4}}" Minimum="0" Maximum="5"
                       Value="{Binding RampIndex4}" />

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.CelShading_RampRowsNote}}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.CelShading_TintSlots}}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.CelShading_LightAreaTint}}" Minimum="0" Maximum="2"
                       Value="{Binding LightAreaTint}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.CelShading_DarkShadow}}" Minimum="0" Maximum="2"
                       Value="{Binding DarkShadowTint}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.CelShading_CoolShadow}}" Minimum="0" Maximum="2"
                       Value="{Binding CoolShadowTint}" />

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.CelShading_CoolShadowNote}}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.CelShading_FaceOnly}}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.CelShading_FaceShadowOffset}}" Minimum="-1" Maximum="1"
                       Value="{Binding FaceShadowOffset}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.CelShading_FaceShadowSoftness}}" Minimum="0.01" Maximum="1"
                       Value="{Binding FaceShadowSoftness}" />

        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.CelShading_FaceRenderType}}" IsChecked="{Binding FaceRender}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.CelShading_DirectionalLight}}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.CelShading_YawSpeed}}" Minimum="0" Maximum="90"
                       Value="{Binding SunYawSpeed}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.CelShading_OutlinePass}}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.CelShading_OutlineAmbient}}" Minimum="0" Maximum="1"
                       Value="{Binding OutlineAmbient}" />

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.CelShading_OutlineNote}}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.CelShading_SettingsAmbient}}" Minimum="0" Maximum="2"
                       Value="{Binding SettingsAmbient}" />

        <kit:ReadoutRow Label="{Translate {x:Static loc:Strings+Keys.CelShading_Bindings}}" Text="{Binding ReadoutText^}" />

      </StackPanel>
    </kit:InspectorPanel>

  </Panel>
</ex:Demo>
