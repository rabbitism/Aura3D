<ex:Demo x:Class="Aura3D.Gallery.Demos.SkyboxBackgroundDemo"
         xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ex="clr-namespace:Aura3D.Gallery"
         xmlns:demos="clr-namespace:Aura3D.Gallery.Demos"
         xmlns:kit="clr-namespace:Aura3D.Gallery.Kit"
         x:DataType="demos:SkyboxBackgroundViewModel">

  <!--
    背景来源与天空盒页：MVVM 化（样板见 Particles 页）。文案与参数全部绑定
    SkyboxBackgroundViewModel——标签是 Lingua observable（^ 绑定，换语言自动生效），
    行控件值双向绑定写穿到场景/相机/平行光；宿主的 PipelineSettings 只有视图够得着，
    两根滑杆的值事件在 code-behind 里转写进去。视图 code-behind 只剩生命周期：
    取资产、装场景、逐帧 Tick。
  -->
  <Panel>

    <kit:DemoView x:Name="View" Pipeline="PBRForward" />

    <kit:InspectorPanel>
      <StackPanel Spacing="6">

        <kit:Hint Text="{Binding IntroLabel^}" />

        <kit:Section Title="{Binding SourceSectionLabel^}" />

        <kit:ComboRow Label="{Binding SourceLabel^}" Options="{Binding SourceOptions}"
                      SelectedItem="{Binding SelectedSource}" />

        <kit:SliderRow Label="{Binding CubeSizeLabel^}" Minimum="32" Maximum="256" Format="0"
                       Value="{Binding CubeFaceSize}" />

        <kit:ToggleRow Label="{Binding RenderBackgroundLabel^}" IsChecked="{Binding RenderBackground}" />

        <kit:Hint Text="{Binding ClearNoteLabel^}" />

        <kit:Section Title="{Binding ShaderVariantsSectionLabel^}" />

        <kit:ToggleRow Label="{Binding OrthographicLabel^}" IsChecked="{Binding Orthographic}" />

        <kit:SliderRow Label="{Binding OrthoSizeLabel^}" Minimum="2" Maximum="40" Format="0"
                       Value="{Binding OrthoSize}" />

        <kit:SliderRow Label="{Binding FieldOfViewLabel^}" Minimum="15" Maximum="120" Format="0"
                       Value="{Binding FieldOfView}" />

        <kit:SliderRow Label="{Binding FarPlaneLabel^}" Minimum="5" Maximum="400" Format="0"
                       Value="{Binding FarPlane}" />

        <kit:Hint Text="{Binding ProjectionNoteLabel^}" />

        <kit:Section Title="{Binding CubemapIblSectionLabel^}" />

        <kit:SliderRow Label="{Binding AmbientLabel^}" Minimum="0" Maximum="4"
                       Value="{Binding IblAmbientIntensity}" />

        <kit:SliderRow Label="{Binding ExposureLabel^}" Minimum="0.05" Maximum="4"
                       Value="{Binding ToneMappingExposure}" />

        <kit:ToggleRow Label="{Binding SunVisibleLabel^}" IsChecked="{Binding SunVisible}" />

        <Button Content="{Binding RebakeIblLabel^}" Command="{Binding RebakeIblCommand}" HorizontalAlignment="Stretch" />

        <kit:Hint Text="{Binding IblNoteLabel^}" />

        <kit:ReadoutRow Label="{Binding IblCacheLabel^}" Text="{Binding ReadoutText^}" />

      </StackPanel>
    </kit:InspectorPanel>

  </Panel>
</ex:Demo>
