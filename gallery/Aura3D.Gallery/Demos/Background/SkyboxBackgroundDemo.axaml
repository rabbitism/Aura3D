<ex:Demo x:Class="Aura3D.Gallery.Demos.SkyboxBackgroundDemo"
         xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:loc="clr-namespace:Aura3D.Gallery.Localization"
         xmlns:ex="clr-namespace:Aura3D.Gallery"
         xmlns:demos="clr-namespace:Aura3D.Gallery.Demos"
         xmlns:kit="clr-namespace:Aura3D.Gallery.Kit"
         x:DataType="demos:SkyboxBackgroundViewModel">

  <!--
    背景来源与天空盒页：MVVM 化（样板见 Particles 页）。文案与参数全部绑定
    SkyboxBackgroundViewModel——标签是 Lingua observable（^ 绑定，换语言自动生效），
    行控件值双向绑定写穿到场景/相机/平行光；宿主的 PipelineSettings 只有视图够得着，
    两根滑杆的值事件在 code-behind 里转写进去。视图 code-behind 只剩生命周期：
    取资产、装场景、逐帧 Tick。
  -->
  <Panel>

    <kit:DemoView x:Name="View" Pipeline="PBRForward" />

    <kit:InspectorPanel>
      <StackPanel Spacing="6">

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.Background_Intro}}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.Background_Source}}" />

        <kit:ComboRow Label="{Translate {x:Static loc:Strings+Keys.Background_SceneBackground}}" Options="{Binding SourceOptions}"
                      SelectedItem="{Binding SelectedSource}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Background_CubeSize}}" Minimum="32" Maximum="256" Format="0"
                       Value="{Binding CubeFaceSize}" />

        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.Background_RenderBackground}}" IsChecked="{Binding RenderBackground}" />

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.Background_ClearNote}}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.Background_ShaderVariants}}" />

        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.Background_Orthographic}}" IsChecked="{Binding Orthographic}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Background_OrthoSize}}" Minimum="2" Maximum="40" Format="0"
                       Value="{Binding OrthoSize}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Background_FieldOfView}}" Minimum="15" Maximum="120" Format="0"
                       Value="{Binding FieldOfView}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Background_FarPlane}}" Minimum="5" Maximum="400" Format="0"
                       Value="{Binding FarPlane}" />

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.Background_ProjectionNote}}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.Background_CubemapFeedsIbl}}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Background_IblAmbientIntensity}}" Minimum="0" Maximum="4"
                       Value="{Binding IblAmbientIntensity}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Background_ToneMappingExposure}}" Minimum="0.05" Maximum="4"
                       Value="{Binding ToneMappingExposure}" />

        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.Background_KeyLightVisible}}" IsChecked="{Binding SunVisible}" />

        <Button Content="{Translate {x:Static loc:Strings+Keys.Background_RebakeIbl}}" Command="{Binding RebakeIblCommand}" HorizontalAlignment="Stretch" />

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.Background_IblNote}}" />

        <kit:ReadoutRow Label="{Translate {x:Static loc:Strings+Keys.Background_IblCache}}" Text="{Binding ReadoutText^}" />

      </StackPanel>
    </kit:InspectorPanel>

  </Panel>
</ex:Demo>
