<ex:Demo x:Class="Aura3D.Gallery.Demos.ShadowsDemo"
         xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:loc="clr-namespace:Aura3D.Gallery.Localization"
         xmlns:ex="clr-namespace:Aura3D.Gallery"
         xmlns:demos="clr-namespace:Aura3D.Gallery.Demos"
         xmlns:kit="clr-namespace:Aura3D.Gallery.Kit"
         x:DataType="demos:ShadowsViewModel">

  <!--
    阴影页：MVVM 化（样板见 Particles/PostProcessing 页）。文案与参数全部绑定 ShadowsViewModel——
    标签是 Lingua observable（^ 绑定，换语言自动生效），行控件值双向绑定到 VM：写灯与相机的
    直接写穿 VM 持有的对象；写宿主 PipelineSettings 的（CSM 三样、平行光上限、调试开关）由
    code-behind 订阅 VM 的值事件逐项转写。Reload 按钮经 ReloadRequested 桥到宿主整页重建。
    视图 code-behind 只剩生命周期：建场景（相机/地面/立柱/球；两盏灯本体住在 VM）、转写参数、逐帧 Tick。
  -->
  <Panel>

    <kit:DemoView x:Name="View" Pipeline="BlinnPhong" />

    <kit:InspectorPanel>
      <StackPanel Spacing="6">

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.Shadows_Intro}}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.Shadows_KeyLight}}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Shadows_Pitch}}" Minimum="-85" Maximum="-5" Format="0"
                       Value="{Binding Pitch}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Shadows_Yaw}}" Minimum="-180" Maximum="180" Format="0"
                       Value="{Binding Yaw}" />

        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.Shadows_KeyCastShadow}}" IsChecked="{Binding CastShadow}" />
        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.Shadows_ExplicitKey}}" IsChecked="{Binding ExplicitKey}" />

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.Shadows_KeyNote}}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.Shadows_SingleMap}}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Shadows_ConfigWidth}}" Minimum="4" Maximum="200" Format="0"
                       Value="{Binding ShadowWidth}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Shadows_ConfigHeight}}" Minimum="4" Maximum="200" Format="0"
                       Value="{Binding ShadowHeight}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Shadows_NearPlane}}" Minimum="0.05" Maximum="40"
                       Value="{Binding ShadowNear}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Shadows_ConfigFarPlane}}" Minimum="5" Maximum="200"
                       Value="{Binding ShadowFar}" />

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.Shadows_ConfigNote}}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.Shadows_Cascades}}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Shadows_CsmCascadeCount}}" Minimum="1" Maximum="4" Format="0"
                       Value="{Binding CsmCascadeCount}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Shadows_SplitLambda}}" Minimum="0" Maximum="1"
                       Value="{Binding CsmSplitLambda}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Shadows_CsmShadowMapResolution}}" Minimum="256" Maximum="4096" Format="0"
                       Value="{Binding CsmShadowMapResolution}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Shadows_FarPlane}}" Minimum="20" Maximum="400" Format="0"
                       Value="{Binding CameraFar}" />

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.Shadows_CsmLiveNote}}" />

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.Shadows_WasmNote}}" />

        <Button Content="{Translate {x:Static loc:Strings+Keys.Shadows_Reload}}" Command="{Binding ReloadCommand}" HorizontalAlignment="Stretch" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.Shadows_LightLimit}}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Shadows_DirectionalLightLimit}}" Minimum="1" Maximum="4" Format="0"
                       Value="{Binding DirectionalLightLimit}" />

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.Shadows_LimitNote}}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.Shadows_Debug}}" />

        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.Shadows_DirectionalVolume}}" IsChecked="{Binding ShowDirectionalLight}" />
        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.Shadows_BoundingBox}}" IsChecked="{Binding ShowBoundingBox}" />

        <kit:ReadoutRow Label="{Translate {x:Static loc:Strings+Keys.Shadows_Resources}}" Text="{Binding ReadoutText^}" />

      </StackPanel>
    </kit:InspectorPanel>

  </Panel>
</ex:Demo>
