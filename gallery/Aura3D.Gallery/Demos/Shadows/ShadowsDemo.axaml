<ex:Demo x:Class="Aura3D.Gallery.Demos.ShadowsDemo"
         xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ex="clr-namespace:Aura3D.Gallery"
         xmlns:demos="clr-namespace:Aura3D.Gallery.Demos"
         xmlns:kit="clr-namespace:Aura3D.Gallery.Kit"
         x:DataType="demos:ShadowsViewModel">

  <!--
    阴影页：MVVM 化（样板见 Particles/PostProcessing 页）。文案与参数全部绑定 ShadowsViewModel——
    标签是 Lingua observable（^ 绑定，换语言自动生效），行控件值双向绑定到 VM：写灯与相机的
    直接写穿 VM 持有的对象；写宿主 PipelineSettings 的（CSM 三样、平行光上限、调试开关）由
    code-behind 订阅 VM 的值事件逐项转写。Reload 按钮经 ReloadRequested 桥到宿主整页重建。
    视图 code-behind 只剩生命周期：建场景（相机/地面/立柱/球；两盏灯本体住在 VM）、转写参数、逐帧 Tick。
  -->
  <Panel>

    <kit:DemoView x:Name="View" Pipeline="BlinnPhong" />

    <kit:InspectorPanel>
      <StackPanel Spacing="6">

        <kit:Hint Text="{Binding IntroLabel^}" />

        <kit:Section Title="{Binding KeyLightSectionLabel^}" />

        <kit:SliderRow Label="{Binding PitchLabel^}" Minimum="-85" Maximum="-5" Format="0"
                       Value="{Binding Pitch}" />
        <kit:SliderRow Label="{Binding YawLabel^}" Minimum="-180" Maximum="180" Format="0"
                       Value="{Binding Yaw}" />

        <kit:ToggleRow Label="{Binding CastShadowLabel^}" IsChecked="{Binding CastShadow}" />
        <kit:ToggleRow Label="{Binding ExplicitKeyLabel^}" IsChecked="{Binding ExplicitKey}" />

        <kit:Hint Text="{Binding KeyNoteLabel^}" />

        <kit:Section Title="{Binding SingleMapSectionLabel^}" />

        <kit:SliderRow Label="{Binding ConfigWidthLabel^}" Minimum="4" Maximum="200" Format="0"
                       Value="{Binding ShadowWidth}" />
        <kit:SliderRow Label="{Binding ConfigHeightLabel^}" Minimum="4" Maximum="200" Format="0"
                       Value="{Binding ShadowHeight}" />
        <kit:SliderRow Label="{Binding NearPlaneLabel^}" Minimum="0.05" Maximum="40"
                       Value="{Binding ShadowNear}" />
        <kit:SliderRow Label="{Binding ConfigFarPlaneLabel^}" Minimum="5" Maximum="200"
                       Value="{Binding ShadowFar}" />

        <kit:Hint Text="{Binding ConfigNoteLabel^}" />

        <kit:Section Title="{Binding CascadesSectionLabel^}" />

        <kit:SliderRow Label="{Binding CascadeCountLabel^}" Minimum="1" Maximum="4" Format="0"
                       Value="{Binding CsmCascadeCount}" />
        <kit:SliderRow Label="{Binding SplitLambdaLabel^}" Minimum="0" Maximum="1"
                       Value="{Binding CsmSplitLambda}" />
        <kit:SliderRow Label="{Binding ShadowMapResolutionLabel^}" Minimum="256" Maximum="4096" Format="0"
                       Value="{Binding CsmShadowMapResolution}" />
        <kit:SliderRow Label="{Binding FarPlaneLabel^}" Minimum="20" Maximum="400" Format="0"
                       Value="{Binding CameraFar}" />

        <kit:Hint Text="{Binding CsmLiveNoteLabel^}" />

        <kit:Hint Text="{Binding WasmNoteLabel^}" />

        <Button Content="{Binding ReloadLabel^}" Command="{Binding ReloadCommand}" HorizontalAlignment="Stretch" />

        <kit:Section Title="{Binding LightLimitSectionLabel^}" />

        <kit:SliderRow Label="{Binding DirectionalLightLimitLabel^}" Minimum="1" Maximum="4" Format="0"
                       Value="{Binding DirectionalLightLimit}" />

        <kit:Hint Text="{Binding LimitNoteLabel^}" />

        <kit:Section Title="{Binding DebugSectionLabel^}" />

        <kit:ToggleRow Label="{Binding DirectionalVolumeLabel^}" IsChecked="{Binding ShowDirectionalLight}" />
        <kit:ToggleRow Label="{Binding BoundingBoxLabel^}" IsChecked="{Binding ShowBoundingBox}" />

        <kit:ReadoutRow Label="{Binding ResourcesLabel^}" Text="{Binding ReadoutText^}" />

      </StackPanel>
    </kit:InspectorPanel>

  </Panel>
</ex:Demo>
