<ex:Demo x:Class="Aura3D.Gallery.Demos.PostProcessingDemo"
         xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ex="clr-namespace:Aura3D.Gallery"
         xmlns:demos="clr-namespace:Aura3D.Gallery.Demos"
         xmlns:kit="clr-namespace:Aura3D.Gallery.Kit"
         x:DataType="demos:PostProcessingViewModel">

  <!--
    管线设置页：MVVM 化（样板见 Particles 页）。文案与参数全部绑定 PostProcessingViewModel——
    标签是 Lingua observable（^ 绑定，换语言自动生效），行控件值双向绑定到 VM；
    宿主的 PipelineSettings 只有视图够得着，VM 的值事件在 code-behind 里逐项转写进去。
    视图 code-behind 只剩生命周期：建场景、转写参数、逐帧 Tick。
  -->
  <Panel>

    <kit:DemoView x:Name="View" Pipeline="BlinnPhong" />

    <kit:InspectorPanel>
      <StackPanel Spacing="6">

        <kit:Hint Text="{Binding IntroLabel^}" />

        <kit:Section Title="{Binding ToneMappingSectionLabel^}" />

        <kit:SliderRow Label="{Binding ExposureLabel^}" Minimum="0.05" Maximum="4" ShowTicks="True"
                       Value="{Binding ToneMappingExposure}" />
        <kit:SliderRow Label="{Binding BrightnessClampLabel^}" Minimum="0.5" Maximum="16" ShowTicks="True"
                       Value="{Binding BrightnessClamp}" />

        <kit:Section Title="{Binding AmbientSectionLabel^}" />

        <kit:SliderRow Label="{Binding AmbientIntensityLabel^}" Minimum="0" Maximum="2" ShowTicks="True"
                       Value="{Binding AmbientIntensity}" />
        <kit:SliderRow Label="{Binding IblAmbientLabel^}" Minimum="0" Maximum="4" ShowTicks="True"
                       Value="{Binding IblAmbientIntensity}" />

        <kit:Section Title="{Binding PostSectionLabel^}" />

        <kit:ToggleRow Label="{Binding FxaaLabel^}" IsChecked="{Binding EnableFxaa}" />
        <kit:ToggleRow Label="{Binding CullingLabel^}" IsChecked="{Binding EnableFrustumCulling}" />

        <kit:Section Title="{Binding RebuildSectionLabel^}" />

        <kit:SliderRow Label="{Binding DirectionalLightLimitLabel^}" Minimum="1" Maximum="10" Format="0" ShowTicks="True"
                       Value="{Binding DirectionalLightLimit}" />
        <kit:SliderRow Label="{Binding PointLightLimitLabel^}" Minimum="1" Maximum="10" Format="0" ShowTicks="True"
                       Value="{Binding PointLightLimit}" />
        <kit:SliderRow Label="{Binding SpotLightLimitLabel^}" Minimum="1" Maximum="10" Format="0" ShowTicks="True"
                       Value="{Binding SpotLightLimit}" />
        <kit:SliderRow Label="{Binding CascadeCountLabel^}" Minimum="1" Maximum="4" Format="0" ShowTicks="True"
                       Value="{Binding CsmCascadeCount}" />
        <kit:SliderRow Label="{Binding SplitLambdaLabel^}" Minimum="0" Maximum="1" ShowTicks="True"
                       Value="{Binding CsmSplitLambda}" />
        <kit:SliderRow Label="{Binding ShadowMapResolutionLabel^}" Minimum="256" Maximum="4096" Format="0" ShowTicks="True"
                       Value="{Binding CsmShadowMapResolution}" />

        <Button Content="{Binding ReloadLabel^}" Command="{Binding ReloadCommand}" HorizontalAlignment="Stretch" />

        <kit:ToggleRow Label="{Binding CastShadowLabel^}" IsChecked="{Binding CastShadow}" />

        <kit:ReadoutRow Label="{Binding MatrixLabel^}" Text="{Binding ReadoutText^}" />

      </StackPanel>
    </kit:InspectorPanel>

  </Panel>
</ex:Demo>
