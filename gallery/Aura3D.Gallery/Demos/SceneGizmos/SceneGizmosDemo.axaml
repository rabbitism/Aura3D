<ex:Demo x:Class="Aura3D.Gallery.Demos.SceneGizmosDemo"
         xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:loc="clr-namespace:Aura3D.Gallery.Localization"
         xmlns:ex="clr-namespace:Aura3D.Gallery"
         xmlns:demos="clr-namespace:Aura3D.Gallery.Demos"
         xmlns:kit="clr-namespace:Aura3D.Gallery.Kit"
         x:DataType="demos:SceneGizmosViewModel">

  <!--
    场景辅助层页：视口 + 右侧检视浮层。文案与参数全部绑定 SceneGizmosViewModel——
    标签是 Lingua observable（^ 绑定，换语言自动生效），行控件值走双向绑定。
    十个开关的真值在宿主 Settings.Debug 与 Scene 上，由 code-behind 订阅 VM 事件转写；
    视图只剩生命周期：组装场景、驱动两盏灯公转与逐帧 Readout。
  -->
  <Panel>

    <kit:DemoView x:Name="View" Pipeline="BlinnPhong" />

    <kit:InspectorPanel>
      <StackPanel Spacing="6">

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.SceneGizmos_Intro}}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.SceneGizmos_Grid}}" />

        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.SceneGizmos_ShowGrid}}" IsChecked="{Binding ShowGrid}" />
        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.SceneGizmos_ShowAxes}}" IsChecked="{Binding ShowAxes}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.SceneGizmos_GridSize}}" Minimum="4" Maximum="60" Format="0" ShowTicks="True"
                       Value="{Binding GridSize}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.SceneGizmos_GridDivisions}}" Minimum="2" Maximum="60" Format="0" ShowTicks="True"
                       Value="{Binding GridDivisions}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.SceneGizmos_AxisLength}}" Minimum="0.5" Maximum="12" ShowTicks="True"
                       Value="{Binding AxisLength}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.SceneGizmos_ArrowSize}}" Minimum="0.02" Maximum="2" ShowTicks="True"
                       Value="{Binding ArrowheadSize}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.SceneGizmos_DebugToggles}}" />

        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.SceneGizmos_BoundingBox}}" IsChecked="{Binding ShowBoundingBox}" />
        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.SceneGizmos_DirectionalVolume}}" IsChecked="{Binding ShowDirectionalLight}" />
        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.SceneGizmos_PointVolume}}" IsChecked="{Binding ShowPointLight}" />
        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.SceneGizmos_SpotVolume}}" IsChecked="{Binding ShowSpotLight}" />
        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.SceneGizmos_CameraFrustum}}" IsChecked="{Binding ShowCamera}" />
        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.SceneGizmos_ParticleBounds}}" IsChecked="{Binding ShowParticleBounds}" />
        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.SceneGizmos_Bones}}" IsChecked="{Binding ShowBone}" />
        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.SceneGizmos_Enable}}" IsChecked="{Binding DebugEnable}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.SceneGizmos_Animation}}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.SceneGizmos_LightOrbit}}" Minimum="0" Maximum="90" Format="0" ShowTicks="True"
                       Value="{Binding LightOrbitSpeed}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.SceneGizmos_SpotOuterAngle}}" Minimum="4" Maximum="70" Format="0" ShowTicks="True"
                       Value="{Binding SpotOuterAngle}" />

        <kit:ReadoutRow Label="{Translate {x:Static loc:Strings+Keys.SceneGizmos_State}}" Text="{Binding ReadoutText^}" />

      </StackPanel>
    </kit:InspectorPanel>

  </Panel>
</ex:Demo>
