<ex:Demo x:Class="Aura3D.Gallery.Demos.InstancingDemo"
         xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ex="clr-namespace:Aura3D.Gallery"
         xmlns:demos="clr-namespace:Aura3D.Gallery.Demos"
         xmlns:kit="clr-namespace:Aura3D.Gallery.Kit"
         x:DataType="demos:InstancingViewModel">

  <!--
    实例化页：MVVM 化。整页就是这两层：视口 + 浮在右侧的检视面板。
    本页锁死 BlinnPhong：右片的实例感知着色器只覆盖 LightPass 的实例分支。
    文案与参数全部绑定 InstancingViewModel——标签是 Lingua observable（^ 绑定，换语言自动生效），
    行控件值走双向绑定写穿到两片 InstancedMesh。视图 code-behind 只剩生命周期：装场景、逐帧驱动。
  -->
  <Panel>

    <kit:DemoView x:Name="View" Pipeline="BlinnPhong" />

    <kit:InspectorPanel>
      <StackPanel Spacing="6">

        <kit:Hint Text="{Binding IntroLabel^}" />

        <kit:SliderRow Label="{Binding PerFieldLabel^}" Minimum="24" Maximum="20000" Format="0"
                       Value="{Binding InstanceCount}" />

        <kit:ComboRow Label="{Binding UpdateModeLabel^}" Options="{Binding UpdateModeOptions}"
                      SelectedItem="{Binding SelectedUpdateMode}" />

        <kit:ToggleRow Label="{Binding WaveLabel^}" IsChecked="{Binding Animate}" />

        <kit:SliderRow Label="{Binding WaveSpeedLabel^}" Minimum="0" Maximum="6" Format="0.0"
                       Value="{Binding WaveSpeed}" />
        <kit:SliderRow Label="{Binding WaveHeightLabel^}" Minimum="0" Maximum="6" Format="0.0"
                       Value="{Binding WaveAmount}" />

        <kit:ToggleRow Label="{Binding CullingLabel^}" IsChecked="{Binding Culling}" />

        <Button Content="{Binding RemoveFrontLabel^}" Command="{Binding RemoveFrontCommand}" HorizontalAlignment="Stretch" />
        <Button Content="{Binding RestoreLabel^}" Command="{Binding RestoreCommand}" HorizontalAlignment="Stretch" />

        <kit:ReadoutRow Label="{Binding CostLabel^}" Text="{Binding ReadoutText^}" />

      </StackPanel>
    </kit:InspectorPanel>

  </Panel>
</ex:Demo>
