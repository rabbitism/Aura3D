<ex:Demo x:Class="Aura3D.Gallery.Demos.HismDemo"
         xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:loc="clr-namespace:Aura3D.Gallery.Localization"
         xmlns:ex="clr-namespace:Aura3D.Gallery"
         xmlns:demos="clr-namespace:Aura3D.Gallery.Demos"
         xmlns:kit="clr-namespace:Aura3D.Gallery.Kit"
         x:DataType="demos:HismViewModel">

  <!--
    HISM 页：MVVM 化。文案与参数全部绑定 HismViewModel——标签是 Lingua observable
    （^ 绑定，换语言自动生效），行控件值走双向绑定写穿到八叉树分组对象。
    视图 code-behind 只剩生命周期：装场景、逐帧驱动。
  -->
  <Panel>

    <kit:DemoView x:Name="View" Pipeline="BlinnPhong" />

    <kit:InspectorPanel>
      <StackPanel Spacing="6">

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.Hism_Intro}}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Hism_InstanceCount}}" Minimum="1000" Maximum="120000" Format="0"
                       Value="{Binding InstanceCount}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Hism_PerGroup}}" Minimum="64" Maximum="4096" Format="0"
                       Value="{Binding MaxPerGroup}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Hism_MaxDepth}}" Minimum="1" Maximum="9" Format="0"
                       Value="{Binding MaxDepth}" />

        <kit:ComboRow Label="{Translate {x:Static loc:Strings+Keys.Hism_MoveMode}}" Options="{Binding MoveModeOptions}"
                      SelectedItem="{Binding SelectedMoveMode}" />

        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.Hism_MoveEveryFrame}}" IsChecked="{Binding MoveEveryFrame}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Hism_MovesPerSecond}}" Minimum="1" Maximum="240" Format="0"
                       Value="{Binding MovesPerSecond}" />

        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.Hism_GroupCulling}}" IsChecked="{Binding GroupCulling}" />

        <Button Content="{Translate {x:Static loc:Strings+Keys.Hism_Clear}}" Command="{Binding ClearInstancesCommand}" HorizontalAlignment="Stretch" />
        <Button Content="{Translate {x:Static loc:Strings+Keys.Hism_Refill}}" Command="{Binding RefillCommand}" HorizontalAlignment="Stretch" />

        <kit:ReadoutRow Label="{Translate {x:Static loc:Strings+Keys.Hism_OctreeState}}" Text="{Binding ReadoutText^}" />

      </StackPanel>
    </kit:InspectorPanel>

  </Panel>
</ex:Demo>
