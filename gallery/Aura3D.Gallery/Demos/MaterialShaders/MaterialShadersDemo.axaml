<ex:Demo x:Class="Aura3D.Gallery.Demos.MaterialShadersDemo"
         xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:loc="clr-namespace:Aura3D.Gallery.Localization"
         xmlns:ex="clr-namespace:Aura3D.Gallery"
         xmlns:demos="clr-namespace:Aura3D.Gallery.Demos"
         xmlns:kit="clr-namespace:Aura3D.Gallery.Kit"
         x:DataType="demos:MaterialShadersViewModel">

  <!--
    材质通道与自定义着色器页。文案与参数全部绑定 MaterialShadersViewModel——标签是 Lingua
    observable（^ 绑定，换语言自动生效），行控件值走双向绑定写穿到 VM 里的材质对象。
    视图 code-behind 只剩生命周期：建场景（摆相机、加灯、登记 VM 的整排网格）、逐帧 Tick。
  -->
  <Panel>

    <kit:DemoView x:Name="View" Pipeline="BlinnPhong" />

    <kit:InspectorPanel>
      <StackPanel Spacing="6">

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.MaterialShaders_Intro}}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.MaterialShaders_Channels}}" />

        <kit:ComboRow Label="{Translate {x:Static loc:Strings+Keys.MaterialShaders_BaseColorMap}}" Options="{Binding BaseColorOptions}"
                      SelectedItem="{Binding SelectedBaseColor}" />

        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.MaterialShaders_NormalMap}}" IsChecked="{Binding ShowNormal}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.MaterialShaders_BothStages}}" />

        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.MaterialShaders_UseConstantShader}}" IsChecked="{Binding UseCustomSolid}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.MaterialShaders_Hue}}" Minimum="0" Maximum="360" Format="0"
                       Value="{Binding Hue}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.MaterialShaders_Tinted}}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.MaterialShaders_TintStrength}}" Minimum="0" Maximum="1"
                       Value="{Binding TintStrength}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.MaterialShaders_Parameters}}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.MaterialShaders_StripeSpeed}}" Minimum="0" Maximum="4" Format="0.0"
                       Value="{Binding StripeSpeed}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.MaterialShaders_FrequencyU}}" Minimum="0" Maximum="16" Format="0.0"
                       Value="{Binding StripeFrequencyU}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.MaterialShaders_FrequencyV}}" Minimum="0" Maximum="16" Format="0.0"
                       Value="{Binding StripeFrequencyV}" />

        <kit:ComboRow Label="{Translate {x:Static loc:Strings+Keys.MaterialShaders_BlendMode}}" Options="{Binding BlendModeOptions}"
                      SelectedItem="{Binding SelectedBlendMode}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.MaterialShaders_AlphaCutoff}}" Minimum="0" Maximum="0.95"
                       Value="{Binding StripeCutoff}" />

        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.MaterialShaders_WriteTime}}" IsChecked="{Binding AnimateTime}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.MaterialShaders_AlphaModes}}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.MaterialShaders_AlphaCutoff}}" Minimum="0" Maximum="0.95" Format="0.00"
                       Value="{Binding AlphaCutoff}" />

        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.MaterialShaders_DoubleSided}}" IsChecked="{Binding DoubleSided}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.MaterialShaders_Scene}}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.MaterialShaders_RotationSpeed}}" Minimum="0" Maximum="90" Format="0"
                       Value="{Binding Spin}" />

        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.MaterialShaders_Grid}}" IsChecked="{Binding ShowGrid}" />

        <kit:ReadoutRow Label="{Translate {x:Static loc:Strings+Keys.MaterialShaders_Runtime}}" Text="{Binding ReadoutText^}" />

      </StackPanel>
    </kit:InspectorPanel>

  </Panel>
</ex:Demo>
