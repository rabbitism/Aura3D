<ex:Demo x:Class="Aura3D.Gallery.Demos.MaterialShadersDemo"
         xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ex="clr-namespace:Aura3D.Gallery"
         xmlns:demos="clr-namespace:Aura3D.Gallery.Demos"
         xmlns:kit="clr-namespace:Aura3D.Gallery.Kit"
         x:DataType="demos:MaterialShadersViewModel">

  <!--
    材质通道与自定义着色器页。文案与参数全部绑定 MaterialShadersViewModel——标签是 Lingua
    observable（^ 绑定，换语言自动生效），行控件值走双向绑定写穿到 VM 里的材质对象。
    视图 code-behind 只剩生命周期：建场景（摆相机、加灯、登记 VM 的整排网格）、逐帧 Tick。
  -->
  <Panel>

    <kit:DemoView x:Name="View" Pipeline="BlinnPhong" />

    <kit:InspectorPanel>
      <StackPanel Spacing="6">

        <kit:Hint Text="{Binding IntroLabel^}" />

        <kit:Section Title="{Binding ChannelsSectionLabel^}" />

        <kit:ComboRow Label="{Binding BaseColorMapLabel^}" Options="{Binding BaseColorOptions}"
                      SelectedItem="{Binding SelectedBaseColor}" />

        <kit:ToggleRow Label="{Binding NormalMapLabel^}" IsChecked="{Binding ShowNormal}" />

        <kit:Section Title="{Binding BothStagesSectionLabel^}" />

        <kit:ToggleRow Label="{Binding UseConstantShaderLabel^}" IsChecked="{Binding UseCustomSolid}" />

        <kit:SliderRow Label="{Binding HueLabel^}" Minimum="0" Maximum="360" Format="0"
                       Value="{Binding Hue}" />

        <kit:Section Title="{Binding TintedSectionLabel^}" />

        <kit:SliderRow Label="{Binding TintStrengthLabel^}" Minimum="0" Maximum="1"
                       Value="{Binding TintStrength}" />

        <kit:Section Title="{Binding ParametersSectionLabel^}" />

        <kit:SliderRow Label="{Binding StripeSpeedLabel^}" Minimum="0" Maximum="4" Format="0.0"
                       Value="{Binding StripeSpeed}" />

        <kit:SliderRow Label="{Binding FrequencyULabel^}" Minimum="0" Maximum="16" Format="0.0"
                       Value="{Binding StripeFrequencyU}" />

        <kit:SliderRow Label="{Binding FrequencyVLabel^}" Minimum="0" Maximum="16" Format="0.0"
                       Value="{Binding StripeFrequencyV}" />

        <kit:ComboRow Label="{Binding BlendModeLabel^}" Options="{Binding BlendModeOptions}"
                      SelectedItem="{Binding SelectedBlendMode}" />

        <kit:SliderRow Label="{Binding AlphaCutoffLabel^}" Minimum="0" Maximum="0.95"
                       Value="{Binding StripeCutoff}" />

        <kit:ToggleRow Label="{Binding WriteTimeLabel^}" IsChecked="{Binding AnimateTime}" />

        <kit:Section Title="{Binding AlphaModesSectionLabel^}" />

        <kit:SliderRow Label="{Binding AlphaCutoffLabel^}" Minimum="0" Maximum="0.95" Format="0.00"
                       Value="{Binding AlphaCutoff}" />

        <kit:ToggleRow Label="{Binding DoubleSidedLabel^}" IsChecked="{Binding DoubleSided}" />

        <kit:Section Title="{Binding SceneSectionLabel^}" />

        <kit:SliderRow Label="{Binding RotationSpeedLabel^}" Minimum="0" Maximum="90" Format="0"
                       Value="{Binding Spin}" />

        <kit:ToggleRow Label="{Binding GridLabel^}" IsChecked="{Binding ShowGrid}" />

        <kit:ReadoutRow Label="{Binding RuntimeLabel^}" Text="{Binding ReadoutText^}" />

      </StackPanel>
    </kit:InspectorPanel>

  </Panel>
</ex:Demo>
