<ex:Demo x:Class="Aura3D.Gallery.Demos.PointcloudMixDemo"
         xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:loc="clr-namespace:Aura3D.Gallery.Localization"
         xmlns:ex="clr-namespace:Aura3D.Gallery"
         xmlns:demos="clr-namespace:Aura3D.Gallery.Demos"
         xmlns:kit="clr-namespace:Aura3D.Gallery.Kit"
         x:DataType="demos:PointcloudMixViewModel">

  <!--
    点云与模型混载页，MVVM 化。文案与三个材质参数全部绑定 PointcloudMixViewModel——标签是
    Lingua observable（^ 绑定，换语言自动生效），行控件值走双向绑定写穿到点云材质。
    glTF 桌子和程序化点云跑在同一个默认管线里，点云的材质只有三个普通参数
    （uPointSize / uUnlit / uUseVertexColor），没有任何着色器覆盖；
    页面不锁管线，切到 PBR 前向/延迟或卡通风，同一份场景照常出图。
  -->
  <Panel>

    <kit:DemoView x:Name="View" Pipeline="BlinnPhong" />

    <kit:InspectorPanel>
      <StackPanel Spacing="6">

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.PointcloudMix_Intro}}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.PointcloudMix_PointSettings}}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.PointcloudMix_PointSize}}" Minimum="1" Maximum="24" Format="0"
                       Value="{Binding PointSize}" />

        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.PointcloudMix_Unlit}}" IsChecked="{Binding Unlit}" />

        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.PointcloudMix_VertexColor}}" IsChecked="{Binding UseVertexColor}" />

      </StackPanel>
    </kit:InspectorPanel>

  </Panel>
</ex:Demo>
