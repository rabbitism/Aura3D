<ex:Demo x:Class="Aura3D.Gallery.Demos.ModelViewerDemo"
         xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ex="clr-namespace:Aura3D.Gallery"
         xmlns:demos="clr-namespace:Aura3D.Gallery.Demos"
         xmlns:kit="clr-namespace:Aura3D.Gallery.Kit"
         x:DataType="demos:ModelViewerViewModel">

  <!--
    glTF 模型页：MVVM 化。文案与参数全部绑定 ModelViewerViewModel——标签是 Lingua observable
    （^ 绑定，换语言自动生效），行控件值走双向绑定写穿到 VM 里的模型节点/副本逻辑。
    视图 code-behind 只剩生命周期：进页即取档的资产、渲染线程回调里组装场景、逐帧 Tick，
    以及按需档「VM 发请求 → 视图下载解码 → 回灌 VM」的那条异步通道。
  -->
  <Panel>

    <kit:DemoView x:Name="View" Pipeline="BlinnPhong" />

    <kit:InspectorPanel>
      <StackPanel Spacing="6">

        <kit:Hint Text="{Binding IntroLabel^}" />

        <kit:Section Title="{Binding ModelSectionLabel^}" />

        <kit:ComboRow Label="{Binding CurrentModelLabel^}" Options="{Binding ModelOptions}"
                      SelectedItem="{Binding SelectedModel}" />

        <Button Content="{Binding FitLabel^}" Command="{Binding FitCommand}" HorizontalAlignment="Stretch" />

        <kit:SliderRow Label="{Binding FitPaddingLabel^}" Minimum="0" Maximum="1"
                       Value="{Binding FitPadding}" />

        <kit:Section Title="{Binding BoundingBoxSectionLabel^}" />

        <kit:SliderRow Label="{Binding BoxPaddingLabel^}" Minimum="0" Maximum="1.5"
                       Value="{Binding BoxPadding}" />

        <kit:ToggleRow Label="{Binding CustomBoxLabel^}" IsChecked="{Binding CustomBox}" />

        <kit:ToggleRow Label="{Binding ShowBoxLabel^}" IsChecked="{Binding ShowBox}" />

        <kit:Hint Text="{Binding BoxNoteLabel^}" />

        <Button Content="{Binding ReframeLabel^}" Command="{Binding FitCommand}" HorizontalAlignment="Stretch" />

        <kit:ReadoutRow Label="{Binding BoxRowLabel^}" Text="{Binding BoxText^}" />

        <kit:Section Title="{Binding CloneModesSectionLabel^}" />

        <kit:ComboRow Label="{Binding CloneTypeLabel^}" Options="{Binding CopyModeOptions}"
                      SelectedItem="{Binding SelectedCopyMode}" />

        <kit:Hint Text="{Binding CloneNoteLabel^}" />

        <Button Content="{Binding ClearClonesLabel^}" Command="{Binding ClearClonesCommand}" HorizontalAlignment="Stretch" />

        <kit:ReadoutRow Label="{Binding SharingLabel^}" Text="{Binding CloneText}" />

        <kit:Section Title="{Binding LoadOnDemandSectionLabel^}" />

        <kit:ReadoutRow Label="{Binding LoadLogLabel^}" Text="{Binding LoadText}" />

        <kit:Section Title="{Binding LoaderOutputSectionLabel^}" />

        <kit:ReadoutRow Label="{Binding StructureLabel^}" Text="{Binding StructureText}" />

      </StackPanel>
    </kit:InspectorPanel>

  </Panel>
</ex:Demo>
