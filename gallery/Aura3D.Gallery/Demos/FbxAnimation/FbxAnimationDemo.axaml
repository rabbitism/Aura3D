<ex:Demo x:Class="Aura3D.Gallery.Demos.FbxAnimationDemo"
         xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:loc="clr-namespace:Aura3D.Gallery.Localization"
         xmlns:ex="clr-namespace:Aura3D.Gallery"
         xmlns:demos="clr-namespace:Aura3D.Gallery.Demos"
         xmlns:kit="clr-namespace:Aura3D.Gallery.Kit"
         x:DataType="demos:FbxAnimationViewModel">

  <!--
    FBX 动作库页（ufbx，纯托管所以四端通用）。MVVM 化：文案、剪辑/骨骼下拉、取样滑杆与三条读数
    全部绑定 FbxAnimationViewModel——标签是 Lingua observable（^ 绑定，换语言自动生效），
    行控件值走双向绑定写穿到 VM 里的模型节点与采样器。骨骼名单要等资产取回后才定，
    由视图建场景时经 PrepareBones 补齐；整页就是视口 + 浮在右侧的检视面板两层。
  -->
  <Panel>

    <kit:DemoView x:Name="View" Pipeline="BlinnPhong" />

    <kit:InspectorPanel>
      <StackPanel Spacing="6">

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.FbxAnimation_Intro}}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.FbxAnimation_Clips}}" />

        <kit:ComboRow Label="{Translate {x:Static loc:Strings+Keys.FbxAnimation_Sampler}}" Options="{Binding ClipOptions}"
                      SelectedItem="{Binding SelectedClip}" />

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.FbxAnimation_NoSamplerNote}}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.FbxAnimation_SampleInterface}}" />

        <kit:ComboRow Label="{Translate {x:Static loc:Strings+Keys.FbxAnimation_Bone}}" Options="{Binding BoneOptions}"
                      SelectedItem="{Binding SelectedBone}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.FbxAnimation_AtSecond}}" Minimum="0" Maximum="2" Format="0.00"
                       Value="{Binding SampleTime}" />

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.FbxAnimation_SampleNote}}" />

        <kit:ReadoutRow Label="{Translate {x:Static loc:Strings+Keys.FbxAnimation_Result}}" Text="{Binding SampleText}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.FbxAnimation_SkeletonLoader}}" />

        <kit:ReadoutRow Label="{Translate {x:Static loc:Strings+Keys.FbxAnimation_Skeleton}}" Text="{Binding SkeletonReadoutText^}" />
        <kit:ReadoutRow Label="{Translate {x:Static loc:Strings+Keys.FbxAnimation_ClipTable}}" Text="{Binding ClipsReadoutText^}" />

      </StackPanel>
    </kit:InspectorPanel>

  </Panel>
</ex:Demo>
