<ex:Demo x:Class="Aura3D.Gallery.Demos.FbxAnimationDemo"
         xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ex="clr-namespace:Aura3D.Gallery"
         xmlns:demos="clr-namespace:Aura3D.Gallery.Demos"
         xmlns:kit="clr-namespace:Aura3D.Gallery.Kit"
         x:DataType="demos:FbxAnimationViewModel">

  <!--
    FBX 动作库页（ufbx，纯托管所以四端通用）。MVVM 化：文案、剪辑/骨骼下拉、取样滑杆与三条读数
    全部绑定 FbxAnimationViewModel——标签是 Lingua observable（^ 绑定，换语言自动生效），
    行控件值走双向绑定写穿到 VM 里的模型节点与采样器。骨骼名单要等资产取回后才定，
    由视图建场景时经 PrepareBones 补齐；整页就是视口 + 浮在右侧的检视面板两层。
  -->
  <Panel>

    <kit:DemoView x:Name="View" Pipeline="BlinnPhong" />

    <kit:InspectorPanel>
      <StackPanel Spacing="6">

        <kit:Hint Text="{Binding IntroLabel^}" />

        <kit:Section Title="{Binding ClipsSectionLabel^}" />

        <kit:ComboRow Label="{Binding SamplerLabel^}" Options="{Binding ClipOptions}"
                      SelectedItem="{Binding SelectedClip}" />

        <kit:Hint Text="{Binding NoSamplerNoteLabel^}" />

        <kit:Section Title="{Binding SampleInterfaceSectionLabel^}" />

        <kit:ComboRow Label="{Binding BoneLabel^}" Options="{Binding BoneOptions}"
                      SelectedItem="{Binding SelectedBone}" />

        <kit:SliderRow Label="{Binding AtSecondLabel^}" Minimum="0" Maximum="2" Format="0.00"
                       Value="{Binding SampleTime}" />

        <kit:Hint Text="{Binding SampleNoteLabel^}" />

        <kit:ReadoutRow Label="{Binding ResultLabel^}" Text="{Binding SampleText}" />

        <kit:Section Title="{Binding SkeletonLoaderSectionLabel^}" />

        <kit:ReadoutRow Label="{Binding SkeletonLabel^}" Text="{Binding SkeletonReadoutText^}" />
        <kit:ReadoutRow Label="{Binding ClipTableLabel^}" Text="{Binding ClipsReadoutText^}" />

      </StackPanel>
    </kit:InspectorPanel>

  </Panel>
</ex:Demo>
