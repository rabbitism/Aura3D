<ex:Demo x:Class="Aura3D.Gallery.Demos.SkinnedAnimationDemo"
         xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ex="clr-namespace:Aura3D.Gallery"
         xmlns:demos="clr-namespace:Aura3D.Gallery.Demos"
         xmlns:kit="clr-namespace:Aura3D.Gallery.Kit"
         x:DataType="demos:SkinnedAnimationViewModel">

  <!--
    蒙皮动画与骨骼挂载页。MVVM 化：文案、参数与命令全在 SkinnedAnimationViewModel——
    标签是 Lingua observable（^ 绑定，换语言自动生效），行控件值走双向绑定写穿采样器
    与骨骼附件。剪辑下拉的选项要到场景组装时才填（动画来自 glb 文件），两条读数
    由视图逐帧 Tick 重读。
  -->
  <Panel>

    <kit:DemoView x:Name="View" Pipeline="BlinnPhong" />

    <kit:InspectorPanel>
      <StackPanel Spacing="6">

        <kit:Hint Text="{Binding IntroLabel^}" />

        <kit:Section Title="{Binding PlaybackSectionLabel^}" />

        <kit:ComboRow Label="{Binding ClipLabel^}" Options="{Binding ClipOptions}"
                      SelectedItem="{Binding SelectedClip}" />

        <kit:SliderRow Label="{Binding TimeScaleLabel^}" Minimum="0" Maximum="3" Format="0.00"
                       Value="{Binding TimeScale}" />

        <kit:ComboRow Label="{Binding LoopModeLabel^}" Options="{Binding LoopModeOptions}"
                      SelectedItem="{Binding SelectedLoopMode}" />

        <Button Content="{Binding ResetLabel^}" Command="{Binding ResetCommand}" HorizontalAlignment="Stretch" />

        <kit:Section Title="{Binding DriverSectionLabel^}" />

        <kit:ToggleRow Label="{Binding ExternalUpdateLabel^}" IsChecked="{Binding ExternalUpdate}" />

        <kit:Hint Text="{Binding DriveNoteLabel^}" />

        <Button Content="{Binding AdvanceStepLabel^}" Command="{Binding AdvanceStepCommand}" HorizontalAlignment="Stretch" />

        <kit:Section Title="{Binding BonesSectionLabel^}" />

        <kit:ToggleRow Label="{Binding ShowBoneLabel^}" IsChecked="{Binding ShowBone}" />

        <kit:ToggleRow Label="{Binding AttachmentLabel^}" IsChecked="{Binding ShowAttachment}" />

        <kit:SliderRow Label="{Binding AttachmentYawLabel^}" Minimum="-180" Maximum="180" Format="0"
                       Value="{Binding AttachmentYaw}" />

        <kit:Hint Text="{Binding AttachNoteLabel^}" />

        <kit:ReadoutRow Label="{Binding BonePickerLabel^}" Text="{Binding BoneReadoutText^}" />

        <kit:ReadoutRow Label="{Binding PlaybackStateLabel^}" Text="{Binding PlaybackReadoutText^}" />

      </StackPanel>
    </kit:InspectorPanel>

  </Panel>
</ex:Demo>
