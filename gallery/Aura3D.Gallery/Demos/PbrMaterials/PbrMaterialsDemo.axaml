<ex:Demo x:Class="Aura3D.Gallery.Demos.PbrMaterialsDemo"
         xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:loc="clr-namespace:Aura3D.Gallery.Localization"
         xmlns:ex="clr-namespace:Aura3D.Gallery"
         xmlns:demos="clr-namespace:Aura3D.Gallery.Demos"
         xmlns:kit="clr-namespace:Aura3D.Gallery.Kit"
         x:DataType="demos:PbrMaterialsViewModel">

  <!--
    PBR 材质页：MVVM 化（模式照抄 Particles）。文案与三颗球在 PbrMaterialsViewModel——
    标签是 Lingua observable（^ 绑定，换语言自动生效），材质序读数是 VM 的普通 string 属性。
    这页没有可调参数，code-behind 只剩生命周期：取资产喂 VM、组场景、逐帧自转。
  -->
  <Panel>

    <kit:DemoView x:Name="View" Pipeline="PBRForward" />

    <kit:InspectorPanel>
      <StackPanel Spacing="6">

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.PbrMaterials_Intro}}" />

        <kit:ReadoutRow Label="{Translate {x:Static loc:Strings+Keys.PbrMaterials_Order}}" Text="{Binding OrderText}" />

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.PbrMaterials_Note}}" />

      </StackPanel>
    </kit:InspectorPanel>

  </Panel>
</ex:Demo>
