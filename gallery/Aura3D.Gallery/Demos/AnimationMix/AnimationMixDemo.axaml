<ex:Demo x:Class="Aura3D.Gallery.Demos.AnimationMixDemo"
         xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ex="clr-namespace:Aura3D.Gallery"
         xmlns:demos="clr-namespace:Aura3D.Gallery.Demos"
         xmlns:kit="clr-namespace:Aura3D.Gallery.Kit"
         x:DataType="demos:AnimationMixViewModel">

  <!--
    动画混合页：左右两份模型同骨骼，各挂一个采样器。MVVM 化：文案、参数与命令全在
    AnimationMixViewModel——标签是 Lingua observable（^ 绑定，换语言自动生效），行控件值
    走双向绑定写穿到状态机节点与混合空间。BlendSpacePad 是强视图交互控件，留在 View：
    拖动事件推进 VM，扫掠/Reset 的轴值由 code-behind 逐帧回显。
  -->
  <Panel>

    <kit:DemoView x:Name="View" Pipeline="BlinnPhong" />

    <kit:InspectorPanel>
      <StackPanel Spacing="6">

        <kit:Hint Text="{Binding IntroLabel^}" />

        <kit:Section Title="{Binding GraphSectionLabel^}" />

        <kit:ToggleRow Label="{Binding AutoToggleLabel^}" IsChecked="{Binding AutoToggle}" />

        <kit:SliderRow Label="{Binding ToggleIntervalLabel^}" Minimum="0.6" Maximum="6" Format="0.0"
                       Value="{Binding ToggleSeconds}" />
        <kit:SliderRow Label="{Binding BlendTimeLabel^}" Minimum="0" Maximum="2" Format="0.00"
                       Value="{Binding BlendTime}" />

        <Button Content="{Binding ManualSwitchLabel^}" Command="{Binding ManualSwitchCommand}" HorizontalAlignment="Stretch" />

        <kit:Hint Text="{Binding TransitionNoteLabel^}" />

        <kit:ReadoutRow Label="{Binding StateMachineLabel^}" Text="{Binding GraphReadoutText}" />

        <kit:Section Title="{Binding BlendSpaceSectionLabel^}" />

        <kit:ToggleRow Label="{Binding AutoSweepLabel^}" IsChecked="{Binding AutoSweep}" />

        <kit:SliderRow Label="{Binding SweepPeriodLabel^}" Minimum="2" Maximum="20" Format="0.0"
                       Value="{Binding SweepPeriod}" />

        <kit:BlendSpacePad x:Name="BlendPad" Height="230"
                           AxisChanged="OnPadAxisChanged" />
        <kit:SliderRow Label="{Binding IdwPowerLabel^}" Minimum="0.5" Maximum="6" Format="0.00"
                       Value="{Binding IdwPower}" />

        <Button Content="{Binding ResetAxesLabel^}" Command="{Binding ResetAxesCommand}" HorizontalAlignment="Stretch" />

        <kit:Hint Text="{Binding BlendSpaceNoteLabel^}" />

        <kit:ReadoutRow Label="{Binding BlendSpaceRowLabel^}" Text="{Binding BlendReadoutText^}" />

      </StackPanel>
    </kit:InspectorPanel>

  </Panel>
</ex:Demo>
