<ex:Demo x:Class="Aura3D.Gallery.Demos.CameraDemo"
         xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:loc="clr-namespace:Aura3D.Gallery.Localization"
         xmlns:ex="clr-namespace:Aura3D.Gallery"
         xmlns:demos="clr-namespace:Aura3D.Gallery.Demos"
         xmlns:kit="clr-namespace:Aura3D.Gallery.Kit"
         x:DataType="demos:CameraViewModel">

  <!--
    相机页：MVVM 化。文案与参数全部绑定 CameraViewModel——标签是 Lingua observable
    （^ 绑定，换语言自动生效），行控件值走双向绑定写穿到 Scene.MainCamera。
    视图 code-behind 只剩场景组装，以及逐帧推进十字标记与屏幕投影读数。
    十字标记只用来对照屏幕坐标口径，所以整层不参与命中测试。
  -->
  <Panel>

    <kit:DemoView x:Name="View" Pipeline="BlinnPhong" />

    <Canvas x:Name="Overlay" IsHitTestVisible="False">
      <Path x:Name="Crosshair"
            Data="M 0,-8 L 0,8 M -8,0 L 8,0"
            Stroke="Yellow"
            StrokeThickness="2" />
    </Canvas>

    <kit:InspectorPanel>
      <StackPanel Spacing="6">

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.Camera_Intro}}" />

        <kit:ComboRow Label="{Translate {x:Static loc:Strings+Keys.Camera_Projection}}" Options="{Binding ProjectionOptions}"
                      SelectedItem="{Binding SelectedProjection}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.Camera_Frustum}}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Camera_FieldOfView}}" Minimum="15" Maximum="120" Format="0" ShowTicks="True"
                       Value="{Binding FieldOfView}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Camera_OrthographicSize}}" Minimum="0.5" Maximum="20" ShowTicks="True"
                       Value="{Binding OrthographicSize}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Camera_NearPlane}}" Minimum="0.01" Maximum="12" ShowTicks="True"
                       Value="{Binding NearPlane}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Camera_FarPlane}}" Minimum="2" Maximum="120" Format="0.#" ShowTicks="True"
                       Value="{Binding FarPlane}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.Camera_Framing}}" />

        <Button Content="{Translate {x:Static loc:Strings+Keys.Camera_FitFifthBox}}" Command="{Binding FitFifthBoxCommand}" HorizontalAlignment="Stretch" />
        <Button Content="{Translate {x:Static loc:Strings+Keys.Camera_ResetCamera}}" Command="{Binding ResetCameraCommand}" HorizontalAlignment="Stretch" />

        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.Camera_RenderBackground}}" IsChecked="{Binding RenderBackground}" />

        <kit:ReadoutRow Label="{Translate {x:Static loc:Strings+Keys.Camera_Box0Projection}}" Text="{Binding ScreenReadoutText}" />

      </StackPanel>
    </kit:InspectorPanel>

  </Panel>
</ex:Demo>
