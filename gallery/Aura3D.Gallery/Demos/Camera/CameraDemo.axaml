<ex:Demo x:Class="Aura3D.Gallery.Demos.CameraDemo"
         xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ex="clr-namespace:Aura3D.Gallery"
         xmlns:demos="clr-namespace:Aura3D.Gallery.Demos"
         xmlns:kit="clr-namespace:Aura3D.Gallery.Kit"
         x:DataType="demos:CameraViewModel">

  <!--
    相机页：MVVM 化。文案与参数全部绑定 CameraViewModel——标签是 Lingua observable
    （^ 绑定，换语言自动生效），行控件值走双向绑定写穿到 Scene.MainCamera。
    视图 code-behind 只剩场景组装，以及逐帧推进十字标记与屏幕投影读数。
    十字标记只用来对照屏幕坐标口径，所以整层不参与命中测试。
  -->
  <Panel>

    <kit:DemoView x:Name="View" Pipeline="BlinnPhong" />

    <Canvas x:Name="Overlay" IsHitTestVisible="False">
      <Path x:Name="Crosshair"
            Data="M 0,-8 L 0,8 M -8,0 L 8,0"
            Stroke="Yellow"
            StrokeThickness="2" />
    </Canvas>

    <kit:InspectorPanel>
      <StackPanel Spacing="6">

        <kit:Hint Text="{Binding IntroLabel^}" />

        <kit:ComboRow Label="{Binding ProjectionLabel^}" Options="{Binding ProjectionOptions}"
                      SelectedItem="{Binding SelectedProjection}" />

        <kit:Section Title="{Binding FrustumSectionLabel^}" />

        <kit:SliderRow Label="{Binding FieldOfViewLabel^}" Minimum="15" Maximum="120" Format="0" ShowTicks="True"
                       Value="{Binding FieldOfView}" />
        <kit:SliderRow Label="{Binding OrthographicSizeLabel^}" Minimum="0.5" Maximum="20" ShowTicks="True"
                       Value="{Binding OrthographicSize}" />
        <kit:SliderRow Label="{Binding NearPlaneLabel^}" Minimum="0.01" Maximum="12" ShowTicks="True"
                       Value="{Binding NearPlane}" />
        <kit:SliderRow Label="{Binding FarPlaneLabel^}" Minimum="2" Maximum="120" Format="0.#" ShowTicks="True"
                       Value="{Binding FarPlane}" />

        <kit:Section Title="{Binding FramingSectionLabel^}" />

        <Button Content="{Binding FitFifthBoxLabel^}" Command="{Binding FitFifthBoxCommand}" HorizontalAlignment="Stretch" />
        <Button Content="{Binding ResetCameraLabel^}" Command="{Binding ResetCameraCommand}" HorizontalAlignment="Stretch" />

        <kit:ToggleRow Label="{Binding RenderBackgroundLabel^}" IsChecked="{Binding RenderBackground}" />

        <kit:ReadoutRow Label="{Binding Box0ProjectionLabel^}" Text="{Binding ScreenReadoutText}" />

      </StackPanel>
    </kit:InspectorPanel>

  </Panel>
</ex:Demo>
