<ex:Demo x:Class="Aura3D.Gallery.Demos.EnvironmentDemo"
         xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ex="clr-namespace:Aura3D.Gallery"
         xmlns:demos="clr-namespace:Aura3D.Gallery.Demos"
         xmlns:kit="clr-namespace:Aura3D.Gallery.Kit"
         x:DataType="demos:EnvironmentViewModel">

  <!--
    环境图与 IBL 页：MVVM 化（样板见 Particles/PostProcessing 页）。文案与参数全部绑定
    EnvironmentViewModel——标签是 Lingua observable（^ 绑定，换语言自动生效），行控件值
    双向绑定写穿到场景/引擎对象；写宿主 Settings 的三项经 VM 值事件在 code-behind 转写。
    视图 code-behind 只剩生命周期：取资产、装场景、逐帧自转与 Tick。
  -->
  <Panel>

    <kit:DemoView x:Name="View" Pipeline="PBRForward" />

    <kit:InspectorPanel>
      <StackPanel Spacing="6">

        <kit:Hint Text="{Binding IntroLabel^}" />

        <kit:Section Title="{Binding MapSectionLabel^}" />

        <kit:ComboRow Label="{Binding PanoramaLabel^}" Options="{Binding PanoramaOptions}"
                      SelectedItem="{Binding SelectedPanorama}" />

        <kit:SliderRow Label="{Binding CubeSizeLabel^}" Minimum="32" Maximum="256" Format="0"
                       Value="{Binding FaceSize}" />

        <kit:Hint Text="{Binding FaceSizeNoteLabel^}" />

        <Button Content="{Binding RebakeLabel^}" Command="{Binding RebakeCommand}" HorizontalAlignment="Stretch" />

        <Button Content="{Binding ReloadLabel^}" Command="{Binding ReloadCommand}" HorizontalAlignment="Stretch" />

        <kit:Hint Text="{Binding BackgroundNoteLabel^}" />

        <kit:Section Title="{Binding IblSplitSectionLabel^}" />

        <kit:SliderRow Label="{Binding IblAmbientLabel^}" Minimum="0" Maximum="4"
                       Value="{Binding IblAmbientIntensity}" />

        <kit:ToggleRow Label="{Binding SunVisibleLabel^}" IsChecked="{Binding SunVisible}" />

        <kit:SliderRow Label="{Binding ExposureLabel^}" Minimum="0.05" Maximum="4"
                       Value="{Binding ToneMappingExposure}" />

        <kit:SliderRow Label="{Binding ClampLabel^}" Minimum="0.5" Maximum="16"
                       Value="{Binding BrightnessClamp}" />

        <kit:ToggleRow Label="{Binding RenderBackgroundLabel^}" IsChecked="{Binding RenderBackground}" />

        <kit:ReadoutRow Label="{Binding CacheStateLabel^}" Text="{Binding ReadoutText^}" />

      </StackPanel>
    </kit:InspectorPanel>

  </Panel>
</ex:Demo>
