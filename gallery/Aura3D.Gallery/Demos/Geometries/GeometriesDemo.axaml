<ex:Demo x:Class="Aura3D.Gallery.Demos.GeometriesDemo"
         xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ex="clr-namespace:Aura3D.Gallery"
         xmlns:demos="clr-namespace:Aura3D.Gallery.Demos"
         xmlns:kit="clr-namespace:Aura3D.Gallery.Kit"
         x:DataType="demos:GeometriesViewModel">

  <!--
    几何体页：视口 + 右侧检视浮层。
    文案与参数全部绑定 GeometriesViewModel——标签是 Lingua observable（^ 绑定，换语言自动生效），
    行控件值走双向绑定，setter 按段重灌对应几何体的顶点；code-behind 只剩生命周期。
  -->
  <Panel>

    <kit:DemoView x:Name="View" Pipeline="BlinnPhong" />

    <kit:InspectorPanel>
      <StackPanel Spacing="6">

        <kit:Hint Text="{Binding IntroLabel^}" />

        <kit:ComboRow Label="{Binding ReadoutKindLabel^}" Options="{Binding KindOptions}"
                      SelectedItem="{Binding SelectedKind}" />

        <kit:Section Title="{Binding BoxSectionLabel^}" />

        <kit:SliderRow Label="{Binding BoxWidthLabel^}" Minimum="0.2" Maximum="6"
                       Value="{Binding BoxWidth}" />
        <kit:SliderRow Label="{Binding BoxHeightLabel^}" Minimum="0.2" Maximum="6"
                       Value="{Binding BoxHeight}" />
        <kit:SliderRow Label="{Binding BoxDepthLabel^}" Minimum="0.2" Maximum="6"
                       Value="{Binding BoxDepth}" />

        <kit:Section Title="{Binding SphereSectionLabel^}" />

        <kit:SliderRow Label="{Binding SphereRadiusLabel^}" Minimum="0.2" Maximum="4"
                       Value="{Binding SphereRadius}" />
        <kit:SliderRow Label="{Binding SphereStacksLabel^}" Minimum="3" Maximum="96" Format="0"
                       Value="{Binding SphereStacks}" />
        <kit:SliderRow Label="{Binding SphereSlicesLabel^}" Minimum="2" Maximum="64" Format="0"
                       Value="{Binding SphereSlices}" />
        <kit:SliderRow Label="{Binding SphereLongitudeLabel^}" Minimum="10" Maximum="360" Format="0"
                       Value="{Binding SphereLongitude}" />

        <kit:Section Title="{Binding CylinderSectionLabel^}" />

        <kit:SliderRow Label="{Binding CylinderTopRadiusLabel^}" Minimum="0.05" Maximum="3"
                       Value="{Binding CylinderTopRadius}" />
        <kit:SliderRow Label="{Binding CylinderBottomRadiusLabel^}" Minimum="0.05" Maximum="3"
                       Value="{Binding CylinderBottomRadius}" />
        <kit:SliderRow Label="{Binding CylinderHeightLabel^}" Minimum="0.2" Maximum="6"
                       Value="{Binding CylinderHeight}" />
        <kit:SliderRow Label="{Binding CylinderSegmentsLabel^}" Minimum="3" Maximum="96" Format="0"
                       Value="{Binding CylinderSegments}" />
        <kit:ToggleRow Label="{Binding CylinderOpenLabel^}" IsChecked="{Binding CylinderOpen}" />

        <kit:Section Title="{Binding PlaneSectionLabel^}" />

        <kit:SliderRow Label="{Binding PlaneWidthLabel^}" Minimum="0.5" Maximum="8"
                       Value="{Binding PlaneWidth}" />
        <kit:SliderRow Label="{Binding PlaneHeightLabel^}" Minimum="0.5" Maximum="8"
                       Value="{Binding PlaneHeight}" />
        <kit:SliderRow Label="{Binding PlaneSectionsXLabel^}" Minimum="1" Maximum="64" Format="0"
                       Value="{Binding PlaneSectionsX}" />
        <kit:SliderRow Label="{Binding PlaneSectionsZLabel^}" Minimum="1" Maximum="64" Format="0"
                       Value="{Binding PlaneSectionsZ}" />

        <kit:Section Title="{Binding SceneSectionLabel^}" />

        <kit:SliderRow Label="{Binding RotationSpeedLabel^}" Minimum="0" Maximum="180" Format="0"
                       Value="{Binding RotationSpeed}" />
        <kit:ToggleRow Label="{Binding GridLabel^}" IsChecked="{Binding ShowGrid}" />
        <kit:ToggleRow Label="{Binding AxesLabel^}" IsChecked="{Binding ShowAxes}" />

        <kit:ReadoutRow Label="{Binding VertexDataLabel^}" Text="{Binding ReadoutText^}" />

      </StackPanel>
    </kit:InspectorPanel>

  </Panel>
</ex:Demo>
