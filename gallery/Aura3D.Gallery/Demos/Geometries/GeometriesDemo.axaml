<ex:Demo x:Class="Aura3D.Gallery.Demos.GeometriesDemo"
         xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:loc="clr-namespace:Aura3D.Gallery.Localization"
         xmlns:ex="clr-namespace:Aura3D.Gallery"
         xmlns:demos="clr-namespace:Aura3D.Gallery.Demos"
         xmlns:kit="clr-namespace:Aura3D.Gallery.Kit"
         x:DataType="demos:GeometriesViewModel">

  <!--
    几何体页：视口 + 右侧检视浮层。
    文案与参数全部绑定 GeometriesViewModel——标签是 Lingua observable（^ 绑定，换语言自动生效），
    行控件值走双向绑定，setter 按段重灌对应几何体的顶点；code-behind 只剩生命周期。
  -->
  <Panel>

    <kit:DemoView x:Name="View" Pipeline="BlinnPhong" />

    <kit:InspectorPanel>
      <StackPanel Spacing="6">

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.Geometries_Intro}}" />

        <kit:ComboRow Label="{Translate {x:Static loc:Strings+Keys.Geometries_ReadoutKind}}" Options="{Binding KindOptions}"
                      SelectedItem="{Binding SelectedKind}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.Geometries_Box}}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Geometries_BoxWidth}}" Minimum="0.2" Maximum="6"
                       Value="{Binding BoxWidth}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Geometries_BoxHeight}}" Minimum="0.2" Maximum="6"
                       Value="{Binding BoxHeight}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Geometries_BoxDepth}}" Minimum="0.2" Maximum="6"
                       Value="{Binding BoxDepth}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.Geometries_Sphere}}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Geometries_SphereRadius}}" Minimum="0.2" Maximum="4"
                       Value="{Binding SphereRadius}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Geometries_SphereStacks}}" Minimum="3" Maximum="96" Format="0"
                       Value="{Binding SphereStacks}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Geometries_SphereSlices}}" Minimum="2" Maximum="64" Format="0"
                       Value="{Binding SphereSlices}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Geometries_SphereLongitude}}" Minimum="10" Maximum="360" Format="0"
                       Value="{Binding SphereLongitude}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.Geometries_Cylinder}}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Geometries_CylinderTopRadius}}" Minimum="0.05" Maximum="3"
                       Value="{Binding CylinderTopRadius}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Geometries_CylinderBottomRadius}}" Minimum="0.05" Maximum="3"
                       Value="{Binding CylinderBottomRadius}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Geometries_CylinderHeight}}" Minimum="0.2" Maximum="6"
                       Value="{Binding CylinderHeight}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Geometries_CylinderSegments}}" Minimum="3" Maximum="96" Format="0"
                       Value="{Binding CylinderSegments}" />
        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.Geometries_CylinderOpen}}" IsChecked="{Binding CylinderOpen}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.Geometries_Plane}}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Geometries_PlaneWidth}}" Minimum="0.5" Maximum="8"
                       Value="{Binding PlaneWidth}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Geometries_PlaneHeight}}" Minimum="0.5" Maximum="8"
                       Value="{Binding PlaneHeight}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Geometries_PlaneSectionsX}}" Minimum="1" Maximum="64" Format="0"
                       Value="{Binding PlaneSectionsX}" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Geometries_PlaneSectionsZ}}" Minimum="1" Maximum="64" Format="0"
                       Value="{Binding PlaneSectionsZ}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.Geometries_Scene}}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Geometries_RotationSpeed}}" Minimum="0" Maximum="180" Format="0"
                       Value="{Binding RotationSpeed}" />
        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.Geometries_Grid}}" IsChecked="{Binding ShowGrid}" />
        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.Geometries_Axes}}" IsChecked="{Binding ShowAxes}" />

        <kit:ReadoutRow Label="{Translate {x:Static loc:Strings+Keys.Geometries_VertexData}}" Text="{Binding ReadoutText^}" />

      </StackPanel>
    </kit:InspectorPanel>

  </Panel>
</ex:Demo>
